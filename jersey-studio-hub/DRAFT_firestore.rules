rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      return isSignedIn() 
        && (
          request.auth.uid == "tMt2S6V1kZgV0y8trHqL1UyvvmJ3"
          || (
            'email' in request.auth.token 
            && (request.auth.token.email.lower() == "itztahirismail@gmail.com" || request.auth.token.email == "itztahirismail@gmail.com")
          )
        ); 
    }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- Validation Helpers ---
    function isValidUser(data) {
      return data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 100
        && data.createdAt == request.time;
    }

    function isValidListing(data) {
      return data.title is string && data.title.size() <= 100
        && data.price is number && data.price > 0
        && data.siloType in ['wardrobe', 'garage']
        && data.sellerId == request.auth.uid
        && data.status == 'published'
        && data.createdAt == request.time;
    }

    function isValidRequest(data) {
      return data.orderId is string && data.orderId.size() <= 50
        && data.listingId is string
        && data.userId == request.auth.uid
        && data.status in ['pending', 'paid']
        && data.createdAt == request.time;
    }

    // --- Rules ---

    match /admins/{adminId} {
      allow read: if isSignedIn();
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) 
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName'])
        && incoming().uid == existing().uid;
    }

    match /listings/{listingId} {
      allow read: if resource.data.status == 'published';
      allow create: if isSignedIn() && isValidListing(incoming()) && isValidId(listingId);
      allow update: if isSignedIn() && (
        isAdmin() || (
          isOwner(existing().sellerId) 
          && isValidListing(incoming())
          && (incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'price', 'images', 'apparelDetails', 'autoDetails']))
        )
      );
      allow delete: if isSignedIn() && (isAdmin() || isOwner(existing().sellerId));
    }

    match /requests/{requestId} {
      allow read: if isOwner(existing().userId) || isAdmin();
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidRequest(incoming()) && isValidId(requestId);
      allow update: if isSignedIn() && (
        isAdmin() || (
          isOwner(existing().userId)
          && incoming().diff(existing()).affectedKeys().hasOnly(['status'])
          && incoming().status == 'paid'
          && existing().status == 'pending'
        )
      );
      allow delete: if isSignedIn() && (isOwner(existing().userId) || isAdmin());
    }
  }
}
